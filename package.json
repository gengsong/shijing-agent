{
  "name": "shijing-agent",
  "version": "0.1.0",
  "description": "Your AI agent changed the UI. Did it get easier? Runs the same user task on the before and after version and reports clicks, path and output diffs. CLI and MCP server for Claude Code, Cursor and Codex.",
  "type": "module",
  "bin": {
    "shijing": "bin/shijing.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "demo": "node bin/shijing.js demo",
    "test": "node --test tests/rules.test.js tests/checks.test.js tests/claude.test.js tests/setup.test.js tests/e2e.test.js tests/mcp.test.js",
    "test:unit": "node --test tests/rules.test.js tests/checks.test.js tests/claude.test.js tests/setup.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agent",
    "ux",
    "usability",
    "regression-testing",
    "playwright",
    "claude",
    "browser-automation",
    "ai-coding",
    "mcp",
    "claude-code",
    "cursor",
    "codex",
    "agent-skills"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.62.0",
    "yaml": "^2.6.0",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gengsong/shijing-agent.git"
  }
}
